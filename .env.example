# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Gemini (required — scoring, keyword extraction, and drafting if DRAFT_MODEL=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Anthropic (optional — only needed if DRAFT_MODEL=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# gemini | claude
DRAFT_MODEL=gemini

# true | false — uses Gemini's google_search grounding tool, no separate news API needed
ENABLE_NEWS_ANGLE=true

# Vercel Postgres — auto-injected when you create a Postgres store in the
# Vercel dashboard (Storage tab) and link it to this project. For local
# scripts (db:schema, seed:voice), copy it into .env.local yourself.
POSTGRES_URL=

# Shared secret for POST /api/admin/init (applies db/schema.sql and seeds
# voice_skill). Generate with: openssl rand -hex 16
ADMIN_SECRET=
